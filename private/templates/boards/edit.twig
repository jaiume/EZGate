{% extends 'layouts/app.twig' %}
{% block title %}{{ board.hardware_id }} — {{ app_name }}{% endblock %}
{% block content %}
<p><a href="{% if board.site_id %}/{% else %}/inventory{% endif %}">Back</a></p>
<h1 class="h3">{{ board.friendly_name ?: board.hardware_id }}</h1>
<p class="text-secondary">
    {% if board.board_type_name %}{{ board.board_type_name }} · {% endif %}
    <code>{{ board.hardware_id }}</code>
</p>
<form method="post" action="/boards/{{ board.id }}" class="card card-body shadow-sm mb-4">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
    <div class="mb-3">
        <label class="form-label" for="friendly_name">Board name</label>
        <input class="form-control" id="friendly_name" name="friendly_name" value="{{ board.friendly_name }}">
        <div class="form-text">This names the physical board. Each virtual device has its own name.</div>
    </div>
    <div class="mb-3">
        <label class="form-label" for="site_id">Site</label>
        <select class="form-select" id="site_id" name="site_id">
            <option value="">Unassigned</option>
            {% for site in sites %}
                <option value="{{ site.id }}" {% if board.site_id == site.id %}selected{% endif %}>{{ site.name }}</option>
            {% endfor %}
        </select>
    </div>
    <button class="btn btn-primary" type="submit">Save board</button>
</form>

<div class="card card-body shadow-sm mb-4" id="virtual-devices">
    <h2 class="h5">Virtual devices</h2>
    <p class="text-secondary">EntryZen addresses a virtual device. Assign relays, and a Wiegand reader when this board has one. Pulse duration is per relay.</p>
    {% for device in board.virtual_devices %}
    <div class="border rounded p-3 mb-3" id="device-{{ device.id }}">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <div>
                <div class="fw-semibold">{{ device.friendly_name ?: 'Unnamed' }}</div>
                <div class="small">
                    <code>{{ device.public_id }}</code>
                    {% include 'partials/copy_hardware_id.twig' with { value: device.public_id } %}
                </div>
            </div>
            <div class="d-flex gap-2">
                {% if device.relays %}
                <form method="post" action="/virtual-devices/{{ device.id }}/trigger" onsubmit="return confirm('Pulse this virtual device?');">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <input type="hidden" name="return_to" value="/boards/{{ board.id }}">
                    <button class="btn btn-sm btn-outline-success" type="submit">Test Trigger</button>
                </form>
                {% endif %}
                <form method="post" action="/virtual-devices/{{ device.id }}/delete" onsubmit="return confirm('Remove this virtual device?');">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <input type="hidden" name="return_to" value="/boards/{{ board.id }}">
                    <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                </form>
            </div>
        </div>
        <form method="post" action="/virtual-devices" class="mt-3">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <input type="hidden" name="return_to" value="/boards/{{ board.id }}">
            <input type="hidden" name="id" value="{{ device.id }}">
            <input type="hidden" name="board_id" value="{{ board.id }}">
            {% include 'virtual_devices/_fields.twig' with { board: board, device: device, pulse_default: board.pulse_default } %}
            <button class="btn btn-sm btn-primary" type="submit">Save virtual device</button>
        </form>
    </div>
    {% else %}
    <p class="text-secondary">No virtual devices yet.</p>
    {% endfor %}

    {% if board.can_add_device %}
    <h3 class="h6">New virtual device</h3>
    <form method="post" action="/virtual-devices">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <input type="hidden" name="return_to" value="/boards/{{ board.id }}">
        <input type="hidden" name="board_id" value="{{ board.id }}">
        {% include 'virtual_devices/_fields.twig' with { board: board, device: null, pulse_default: board.pulse_default } %}
        <button class="btn btn-sm btn-outline-primary" type="submit">Create</button>
    </form>
    {% endif %}
</div>
<div class="card card-body shadow-sm mb-4">
    <h2 class="h5">Firmware</h2>
    <p class="mb-0">
        Running
        <strong>{{ board.reported_firmware_version ?: 'unknown' }}</strong>
        {% if board.reported_fallback_firmware_version %}
            <span class="text-secondary">· fallback {{ board.reported_fallback_firmware_version }}</span>
        {% endif %}
        {% if board.target_firmware_version and board.target_firmware_version != board.reported_firmware_version %}
            <span class="text-warning">· pending {{ board.target_firmware_version }}</span>
            {% if board.ota_progress_label %}
                <span class="text-secondary">· {{ board.ota_progress_label }}</span>
            {% endif %}
        {% endif %}
    </p>
</div>
<div class="card card-body">
    <h2 class="h5">Last heartbeat</h2>
    <dl class="row mb-0">
        <dt class="col-sm-3">When</dt>
        <dd class="col-sm-9">{{ board.last_heartbeat_at|utc_time('Never') }}</dd>
        <dt class="col-sm-3">Uptime</dt>
        <dd class="col-sm-9">{{ board.uptime_label ?: '—' }}</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">{{ board.last_status ?: '—' }}</dd>
        <dt class="col-sm-3">Gate state</dt>
        <dd class="col-sm-9">{{ board.last_gate_state ?: '—' }}</dd>
        <dt class="col-sm-3">WiFi</dt>
        <dd class="col-sm-9">
            {% if board.last_wifi_ssid %}
                <span class="wifi-ssid">{{ board.last_wifi_ssid }}</span>
                {% if board.last_wifi_rssi is not null %}({{ board.last_wifi_rssi }} dBm){% endif %}
            {% else %}
                —
            {% endif %}
        </dd>
        <dt class="col-sm-3">Current firmware</dt>
        <dd class="col-sm-9">{{ board.reported_firmware_version ?: '—' }}</dd>
        <dt class="col-sm-3">Fallback firmware</dt>
        <dd class="col-sm-9">{{ board.reported_fallback_firmware_version ?: '—' }}</dd>
        <dt class="col-sm-3">Reported config</dt>
        <dd class="col-sm-9">{{ board.reported_config_version|utc_time }}</dd>
        <dt class="col-sm-3">Portal config</dt>
        <dd class="col-sm-9">{{ board.config_updated_at|utc_time }}</dd>
    </dl>
</div>
{% endblock %}
