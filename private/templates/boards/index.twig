{% extends 'layouts/app.twig' %}
{% block title %}Boards — {{ app_name }}{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Boards</h1>
    <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#addBoardModal" aria-label="Add board">+</button>
</div>

{% if boards %}
<div class="accordion" id="boardList">
    {% for board in boards %}
    {% set isOpen = open_id == board.id %}
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button{% if not isOpen %} collapsed{% endif %}" type="button" data-bs-toggle="collapse" data-bs-target="#board-{{ board.id }}" aria-expanded="{{ isOpen ? 'true' : 'false' }}">
                <span class="me-auto text-truncate pe-3">
                    <span class="fw-semibold">{{ board.friendly_name ?: board.hardware_id }}</span>
                    {% if board.friendly_name %}<span class="text-secondary ms-2"><code>{{ board.hardware_id }}</code></span>{% endif %}
                </span>
                {% if board.online %}
                    <span class="badge text-bg-success me-3">Online</span>
                {% else %}
                    <span class="badge text-bg-secondary me-3">Offline</span>
                {% endif %}
                <span class="text-secondary small text-nowrap me-3">{{ board.link_label ?: '—' }}</span>
                <span class="text-secondary small text-nowrap me-3">{{ board.last_heartbeat_at|utc_time('Never') }}</span>
                <span class="text-secondary small text-nowrap me-2">
                    {% if board.signal_rssi is not null %}{{ board.signal_rssi }} dBm{% else %}—{% endif %}
                </span>
            </button>
        </h2>
        <div id="board-{{ board.id }}" class="accordion-collapse collapse{% if isOpen %} show{% endif %}" data-bs-parent="#boardList">
            <div class="accordion-body">
                <dl class="row mb-3">
                    <dt class="col-sm-3">Current firmware</dt>
                    <dd class="col-sm-9">
                        {{ board.reported_firmware_version ?: '—' }}
                        {% if board.target_firmware_version and board.target_firmware_version != board.reported_firmware_version %}
                            <div class="small text-warning">Pending {{ board.target_firmware_version }}</div>
                            {% if board.ota_progress_label %}
                                <div class="small">{{ board.ota_progress_label }}</div>
                            {% endif %}
                        {% endif %}
                    </dd>
                    <dt class="col-sm-3">Fallback firmware</dt>
                    <dd class="col-sm-9">{{ board.reported_fallback_firmware_version ?: '—' }}</dd>
                    <dt class="col-sm-3">Site</dt>
                    <dd class="col-sm-9">{{ board.site_name ?: 'Unassigned' }}</dd>
                    <dt class="col-sm-3">Route to portal</dt>
                    <dd class="col-sm-9">
                        {% if board.portal_route|length > 1 %}
                            <div class="d-flex flex-wrap align-items-center gap-1">
                                {% for hop in board.portal_route %}
                                    {% if not loop.first %}<span class="text-secondary px-1">&rarr;</span>{% endif %}
                                    <span>
                                        {{ hop.label }}
                                        {% if hop.detail is defined %}<span class="small text-secondary">({{ hop.detail }})</span>{% endif %}
                                    </span>
                                {% endfor %}
                            </div>
                        {% else %}
                            <span class="text-secondary">No path to the portal reported.</span>
                        {% endif %}
                    </dd>
                </dl>
                <div class="d-flex flex-wrap gap-2">
                    {% if board.relay_count is not defined or board.relay_count <= 1 %}
                    <form method="post" action="/boards/{{ board.id }}/trigger" class="mb-0" onsubmit="return confirm('Queue an open pulse on this board?');">
                        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                        <button class="btn btn-sm btn-outline-success" type="submit">Test Trigger</button>
                    </form>
                    {% endif %}
                    <a class="btn btn-sm btn-outline-primary" href="/boards/{{ board.id }}">Edit</a>
                </div>
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% else %}
<p class="text-secondary mb-0">No boards in inventory yet.</p>
{% endif %}

<div class="modal fade" id="addBoardModal" tabindex="-1" aria-labelledby="addBoardModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" action="/boards" class="modal-content">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <div class="modal-header">
                <h2 class="modal-title h5" id="addBoardModalLabel">Add to inventory</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label class="form-label" for="hardware_id">Board identifier</label>
                <input class="form-control" id="hardware_id" name="hardware_id" required autofocus placeholder="Board unique id">
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" type="submit">Add to inventory</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
