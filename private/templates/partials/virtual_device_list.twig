<div class="mt-3">
    <h3 class="h6">Virtual devices</h3>
    {% if board.virtual_devices %}
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-2">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Public id</th>
                    <th>Relays</th>
                    <th>Reader</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for device in board.virtual_devices %}
                <tr id="device-{{ device.id }}" style="scroll-margin-top: 5rem;">
                    <td>
                        {{ device.friendly_name ?: 'Unnamed' }}
                        {% if device.operation == 'autonomous' %}
                            <span class="badge text-bg-light border">Autonomous</span>
                        {% elseif device.operation == 'reader_only' %}
                            <span class="badge text-bg-light border">Reader only</span>
                        {% elseif device.relays %}
                            <span class="badge text-bg-light border">Opener</span>
                        {% endif %}
                    </td>
                    <td class="text-nowrap">
                        <code>{{ device.public_id }}</code>
                        {% include 'partials/copy_hardware_id.twig' with { value: device.public_id } %}
                    </td>
                    <td>
                        {% for relay in device.relays %}
                            {{ relay.relay }} ({{ relay.pulse_resolved }} ms){% if not loop.last %}, {% endif %}
                        {% else %}
                            —
                        {% endfor %}
                    </td>
                    <td>
                        {% if device.wiegand_reader %}
                            {{ device.wiegand_reader }}
                            <span class="small text-secondary">· list {{ device.accesstag_list_version ?: 'none' }} ({{ device.accesstag_count }})</span>
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td class="text-nowrap">
                        {% if device.relays %}
                        <form method="post" action="/virtual-devices/{{ device.id }}/trigger" class="d-inline" onsubmit="return confirm('Pulse this virtual device?');">
                            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                            <input type="hidden" name="return_to" value="{{ return_to }}">
                            <button class="btn btn-sm btn-outline-success" type="submit">Test Trigger</button>
                        </form>
                        {% endif %}
                        <a class="btn btn-sm btn-outline-primary" href="/boards/{{ board.id }}#device-{{ device.id }}">Edit</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <p class="text-secondary mb-2">No virtual devices on this board.</p>
    {% endif %}
</div>
