{% extends 'layouts/app.twig' %}
{% block title %}USB — {{ app_name }}{% endblock %}
{% block content %}
<div
    id="usb-page"
    data-csrf="{{ csrf_token }}"
    data-usb='{"nvsAddress":36864,"nvsSize":20480,"appAddress":65536,"flashSize":"8MB","flashMode":"qio","flashFreq":"80m"}'
    data-sites="{{ sites|json_encode|e('html_attr') }}"
>
    <h1 class="h3 mb-3">USB</h1>
    <p class="text-secondary">Connect opens the COM port. Choose <strong>CDC</strong> for serial commands while firmware is running or booting, or <strong>Download</strong> to flash. CDC sends <code>EZGUSB</code>; the board answers once and then waits for commands. Nothing here reboots the board; press RST when you want it to boot. Setup Wi‑Fi is <code>EZGate-</code> plus the last four of the board id, password <code>ezgate-setup</code>.</p>

    <div class="card shadow-sm mb-3">
        <div class="card-body d-flex align-items-start gap-3">
            <div class="flex-grow-1">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span id="usb-mode-badge" class="badge text-bg-secondary">Disconnected</span>
                </div>
                <div id="usb-status" class="mb-0">
                    {% if not firmware_versions %}
                        <span class="text-secondary">Publish a USB factory firmware image before loading over USB.</span>
                    {% else %}
                        <span class="text-secondary">Click Connect, then choose CDC or Download.</span>
                    {% endif %}
                </div>
            </div>
            <div class="d-flex flex-nowrap gap-2 flex-shrink-0">
                <button class="btn btn-outline-primary" type="button" id="usb-connect">Connect</button>
                <button class="btn btn-outline-secondary d-none" type="button" id="usb-mode-cdc">CDC</button>
                <button class="btn btn-outline-secondary d-none" type="button" id="usb-mode-download">Download</button>
                <button class="btn btn-outline-secondary d-none" type="button" id="usb-disconnect">Disconnect</button>
            </div>
        </div>
        <div id="usb-dock"></div>
        <pre id="usb-log" class="small bg-dark text-light mb-0 px-3 py-2 d-none" style="max-height: 10rem; overflow: auto;"></pre>
    </div>
</div>

<div class="modal fade" id="loadFirmwareModal" tabindex="-1" aria-labelledby="loadFirmwareModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form id="loadFirmwareForm" class="modal-content">
            <input type="hidden" name="board_id" id="load_board_id">
            <div class="modal-header">
                <h2 class="modal-title h5" id="loadFirmwareModalLabel">Load firmware</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-secondary small" id="loadFirmwareHelp">Writes the factory image only. The board stays in Download; press RST, then click CDC for serial commands.</p>
                {% if firmware_versions %}
                <label class="form-label" for="load_firmware_id">Firmware</label>
                <select class="form-select" id="load_firmware_id" name="firmware_id" required>
                    {% for version in firmware_versions %}
                        <option value="{{ version.id }}" data-board-type="{{ version.board_type_id }}">{{ version.version }}{% if version.board_type_name %} · {{ version.board_type_name }}{% endif %}</option>
                    {% endfor %}
                </select>
                {% else %}
                <p class="mb-0">No USB factory firmware versions in the catalog.</p>
                {% endif %}
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" type="submit"{% if not firmware_versions %} disabled{% endif %}>Load firmware</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="boardTypeModal" tabindex="-1" aria-labelledby="boardTypeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form id="boardTypeForm" class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="boardTypeModalLabel">Board type</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-secondary">This hardware id is not saved yet. Choose the board type to add it to inventory.</p>
                <p class="mb-3"><code id="boardTypeHardwareId"></code></p>
                <label class="form-label" for="board_type_choice">Board type</label>
                <select class="form-select" id="board_type_choice" required>
                    <option value="">Choose a board type</option>
                    {% for type in board_types %}
                        <option value="{{ type.name }}">{{ type.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" type="submit">Save board</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
{% block scripts %}
<script type="module" src="/js/usb.js?v=18"></script>
{% endblock %}
