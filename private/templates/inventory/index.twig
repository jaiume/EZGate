{% extends 'layouts/app.twig' %}
{% block title %}Inventory — {{ app_name }}{% endblock %}
{% block content %}
<div id="inventory-page">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Inventory</h1>
        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#addBoardModal">+ Board</button>
    </div>
    <p class="text-secondary">Unassigned boards only. Each board lists its virtual devices. Flash and keys are on the <a href="/usb">USB</a> page, including boards already on a site. After a board joins a site it also appears on the Dashboard.</p>

    {% if boards %}
    <div class="accordion" id="inventoryList">
        {% for board in boards %}
        {% set isOpen = open_id == board.id %}
        <div class="accordion-item" id="board-row-{{ board.id }}" data-board-id="{{ board.id }}">
            <h2 class="accordion-header">
                <button class="accordion-button{% if not isOpen %} collapsed{% endif %} py-2" type="button" data-bs-toggle="collapse" data-bs-target="#board-{{ board.id }}" aria-expanded="{{ isOpen ? 'true' : 'false' }}">
                    <span class="me-auto text-truncate pe-3 d-inline-flex align-items-center">
                        <span class="fw-semibold">{{ board.friendly_name ?: board.hardware_id }}</span>
                        {% if board.board_type_name %}<span class="badge text-bg-light border ms-2">{{ board.board_type_name }}</span>{% endif %}
                        {% if board.friendly_name %}<span class="text-secondary ms-2"><code>{{ board.hardware_id }}</code></span>{% endif %}
                    </span>
                    {% if board.online %}
                        <span class="badge text-bg-success me-3">Online</span>
                    {% else %}
                        <span class="badge text-bg-secondary me-3">Offline</span>
                    {% endif %}
                    {% if board.config_pending %}
                        <span class="badge text-bg-warning text-dark me-3">Pending config</span>
                    {% endif %}
                    {% if board.firmware_pending %}
                        <span class="badge text-bg-warning text-dark me-3">Pending firmware{% if board.ota_percent is not null %} {{ board.ota_percent }}%{% endif %}</span>
                    {% endif %}
                    <span class="text-secondary small text-nowrap me-3">{{ board.site_name ?: 'Unassigned' }}</span>
                    <span class="text-secondary small text-nowrap me-3">{{ board.link_label ?: '—' }}</span>
                    <span class="text-secondary small text-nowrap me-3">{{ board.last_heartbeat_at|utc_time('Never') }}</span>
                    <span class="text-secondary small text-nowrap me-2">
                        {% if board.signal_rssi is not null %}{{ board.signal_rssi }} dBm{% else %}—{% endif %}
                    </span>
                </button>
            </h2>
            <div id="board-{{ board.id }}" class="accordion-collapse collapse{% if isOpen %} show{% endif %}">
                <div class="accordion-body">
                    <dl class="row mb-3">
                        <dt class="col-sm-3">Current firmware</dt>
                        <dd class="col-sm-9">
                            {{ board.reported_firmware_version ?: '—' }}
                            {% if board.firmware_pending %}
                                <div class="small text-warning">Pending {{ board.target_firmware_version }}</div>
                                {% if board.ota_progress_label %}
                                    <div class="small">{{ board.ota_progress_label }}</div>
                                    <div class="progress mt-1" style="max-width: 16rem; height: 0.5rem;" role="progressbar" aria-valuenow="{{ board.ota_percent }}" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar bg-warning" style="width: {{ board.ota_percent }}%"></div>
                                    </div>
                                {% endif %}
                            {% endif %}
                        </dd>
                        <dt class="col-sm-3">Fallback firmware</dt>
                        <dd class="col-sm-9">{{ board.reported_fallback_firmware_version ?: '—' }}</dd>
                        <dt class="col-sm-3">Uptime</dt>
                        <dd class="col-sm-9">{{ board.uptime_label ?: '—' }}</dd>
                        <dt class="col-sm-3">Configuration</dt>
                        <dd class="col-sm-9">
                            {% if board.config_pending %}
                                <span class="text-warning">Pending configuration change</span>
                            {% else %}
                                Up to date
                            {% endif %}
                        </dd>
                        <dt class="col-sm-3">Site</dt>
                        <dd class="col-sm-9">{{ board.site_name ?: 'Unassigned' }}                        </dd>
                    </dl>
                    {% include 'partials/virtual_device_list.twig' with { board: board, return_to: '/inventory' } %}
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <a class="btn btn-sm btn-outline-primary" href="/boards/{{ board.id }}">Edit</a>
                        <a class="btn btn-sm btn-outline-primary" href="/usb">USB tools</a>
                        <form method="post" action="/boards/{{ board.id }}/delete" class="mb-0" onsubmit="return confirm('Delete {{ (board.friendly_name ?: board.hardware_id)|e('js') }} from inventory? Its hardware id is removed. Connecting it again will ask for the board type. This cannot be undone.');">
                            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                            <input type="hidden" name="return_to" value="/inventory">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                        </form>
                    </div>
                    <form method="post" action="/boards/{{ board.id }}/move" class="row g-2 align-items-end">
                        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                        <input type="hidden" name="return_to" value="/inventory">
                        <div class="col-sm-6 col-md-4">
                            <label class="form-label" for="site-{{ board.id }}">Move to site</label>
                            <select class="form-select form-select-sm" id="site-{{ board.id }}" name="site_id">
                                <option value="">Unassigned</option>
                                {% for site in sites %}
                                    <option value="{{ site.id }}"{% if board.site_id == site.id %} selected{% endif %}>{{ site.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-sm btn-outline-secondary" type="submit">Move</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <p class="text-secondary mb-0">No unassigned boards. Connect one on the <a href="/usb">USB</a> page, add its identifier, or see assigned boards on the Dashboard.</p>
    {% endif %}
</div>

<div class="modal fade" id="addBoardModal" tabindex="-1" aria-labelledby="addBoardModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" action="/boards" class="modal-content">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <input type="hidden" name="return_to" value="/inventory">
            <div class="modal-header">
                <h2 class="modal-title h5" id="addBoardModalLabel">Add to inventory</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label class="form-label" for="hardware_id">Board identifier</label>
                <input class="form-control mb-3" id="hardware_id" name="hardware_id" required placeholder="Board unique id">
                <label class="form-label" for="inventory_board_type_id">Board type</label>
                <select class="form-select" id="inventory_board_type_id" name="board_type_id" required>
                    <option value="">Choose a board type</option>
                    {% for type in board_types %}
                        <option value="{{ type.id }}">{{ type.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" type="submit">Add to inventory</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
