<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ app_name }}{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/app.css?v=3" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top mb-4">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center py-0" href="/">
            <img class="navbar-brand-logo" src="/images/ezgate-logo-200.png?v=2" alt="{{ app_name }}">
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" href="/">Dashboard</a></li>
                <li class="nav-item"><a class="nav-link" href="/inventory">Inventory</a></li>
                <li class="nav-item"><a class="nav-link" href="/usb">USB</a></li>
                <li class="nav-item"><a class="nav-link" href="/ota">OTA</a></li>
                <li class="nav-item"><a class="nav-link" href="/help">Help</a></li>
            </ul>
            <form method="post" action="/logout" class="d-flex">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <button class="btn btn-outline-primary btn-sm" type="submit">Log out</button>
            </form>
        </div>
    </div>
</nav>
<main class="container pb-5">
    {% if notice %}
        <div class="alert alert-success">{{ notice }}</div>
    {% endif %}
    {% if error %}
        <div class="alert alert-danger">{{ error }}</div>
    {% endif %}
    {% block content %}{% endblock %}
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/copy.js?v=2"></script>
<script>
(function () {
    var nodes = document.querySelectorAll('time[data-utc][datetime]');
    if (!nodes.length) {
        return;
    }
    var formatter = new Intl.DateTimeFormat(undefined, {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
        second: '2-digit',
        timeZoneName: 'short'
    });
    nodes.forEach(function (el) {
        var iso = el.getAttribute('datetime');
        if (!iso) {
            return;
        }
        var date = new Date(iso);
        if (Number.isNaN(date.getTime())) {
            return;
        }
        el.textContent = formatter.format(date);
    });
})();
</script>
{% block scripts %}{% endblock %}
</body>
</html>
